            }
            Pose {
              translation 0.0238 0.015 0
              children [
                Shape {
                  geometry Box {
                    size 0.005 0.04 0.01
                  }
                }
              ]
            }
          ]
        }
        physics Physics {
          density -1
          mass 0.3
          centerOfMass [
            0 0 0
          ]
          inertiaMatrix [
            0.005 0.005 0.001
            0 0 0
          ]
        }
      }
    }


   









