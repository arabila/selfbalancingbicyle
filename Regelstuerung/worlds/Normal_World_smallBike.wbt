#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "../protos/Supervisor.proto"

#--------------------- Definition der Welt ---------------------
WorldInfo {
  basicTimeStep 2
  contactProperties [
    ContactProperties {
      material1 "wheel"
      material2 "ground"
      coulombFriction [
        0.8
      ]
      bounce 0.1
    }
  ]
}

#--------------------- Definition der Kamera ---------------------
Viewpoint {
  orientation 0.09218476428047824 -0.17977922318869627 -0.9793780680330868 4.758748796181182
  position -3.8591097144925346 -24.413607006773702 5.826066991971595
  follow "BICYCLE"
}

#--------------------- Definition des Hintergrunds ---------------------
TexturedBackground {
  skybox FALSE
}
TexturedBackgroundLight {
}


#--------------------- Definition des Bodens ---------------------
RectangleArena {
  translation 0 0 -0.1 
  contactMaterial "ground"
  floorSize 10 10
  floorTileSize 10 10
  floorAppearance PBRAppearance {
    baseColorMap ImageTexture {
      url [
        "textures/track004.png"
      ]
    }
    roughness 1 #keine Reflektionen
    metalness 0 #keine Metalleigenschaften
  }
  wallThickness 0.001
  wallHeight 0.001
}

#--------------------- Definition des Fahrrads ---------------------

DEF BICYCLE Robot {#Beginn des Robot Roots
  translation -2.5291 -3.22077 -0.0492097 #Position des Fahrrads
  rotation 0.0022654579487756074 -0.00020923791275967243 0.9999974119565402 3.1414438733326446 #Orientierung des Fahrrads
  children [#eröffnet die Liste aller direkten Unterknoten (Ebene 1) des Robots.
  # frame, rear_wheel, crank, Handlebars_and_Fork sind die Unterknoten des Robot Roots.


    #Rein visuell daher keine große Bedeutung
    DEF frame Transform { #Definition des Rahmens des Fahrrads
      scale 0.001 0.001 0.001 #Skalierung des Rahmens des Fahrrads
      children [
        CadShape { #Definition des Rahmens des Fahrrads ohne Höhe in bounding Object definiert
          url [
            "obj/Little Bicycle V2 - Frame/frame.obj" #Pfad zum OBJ-Modell des Rahmens des Fahrrads
          ]
        }
      ]
    }



    DEF rear_wheel HingeJoint { #Definition der Hinterachse

      jointParameters HingeJointParameters { #Definition der Hinterachse
        position 0 #Startwinkel der Hinterrades
        anchor 0 0.083 0 #Ankerpunkt der Hinterachse
        dampingConstant 0.1 #Je schneller sich das Rad dreht, desto stärker wird es abgebremst.
        staticFriction 0.1 # Haftreibung in N·m. Solange das anliegende Drehmoment kleiner als 
                           #0,1 N·m ist, bleibt das Gelenk stehen; erst darüber beginnt es sich zu drehen.
      }

      device [
        RotationalMotor {
          name "motor::wheel" #Refetenz auf Motor aus balance_control_c.c
          maxVelocity 200 #Maximale Drehzahl des Motors in rad/s (verhindert unendliche Beschleunigung.)
          multiplier 2 #	multiplier skaliert Befehlswerte, damit du z. B. mit Kommandos zwischen
                       # −1 … +1 arbeiten und trotzdem bis ±200 rad/s erreichen kannst.
        }
      ]

      endPoint Solid {
        translation 0 0.083 0 #Position der Hinterachse
        rotation -1 0 0 1.9514567889667116 #Orientierung der Hinterachse

        children [
          DEF wheel Transform {
            scale 0.001 0.001 0.001
            children [
              CadShape {#CadShape lädt das hochaufgelöste OBJ-Mesh aus deiner “obj/…/r_wheel.obj”-Datei und skaliert es auf 1/1000.
                url [
                  "obj/Little Bicycle - Rear Wheel/r_wheel.obj"
                ]
              }
            ]
          }
        ]

        contactMaterial "wheel" #Referenz auf den Kontaktmaterial "wheel" aus der WorldInfo

        boundingObject Pose {# Kollisions-Hülle dieses Solids
          rotation 0 1 0 1.5708
          children [
            Cylinder {
              height 0.015 #Kontakt-Hülle des Rades
              radius 0.055 #Radius des Rades
              subdivision 72 #Anzahl der Segmente für die Oberfläche des Zylinders
            }
          ]
        }

        physics Physics {
          density -1 #Dichte des Rades (irrelevant)
          mass 0.8 #1,2 kg als praxisnahen Mittelwert
          centerOfMass [ #Schwerpunkt des Rades
            0 0 0
          ]
          inertiaMatrix [ #Trägheitsmoment des Rades
            0.001 0.001 0.001
            0 0 0
          ]

          #inertiaMatrix [     # xx   yy   zz
          #0.0018 0.0018 0.0036
          #0 0 0
        }

      }

    }





     DEF Handlebars_and_Fork HingeJoint { #Definition der Lenkachse
      
      jointParameters HingeJointParameters {
        axis 0 0 1 #Achse des Gelenks
        anchor 0 -0.0818 0.102 #Lagerpunkt relativ zum Hauptrahmen
        dampingConstant 0.2 # Doppelte kraft zum einlenken für für forderrad
        staticFriction 0.1 #Haftreibung in N·m. Solange das anliegende Drehmoment kleiner als 
                           #0,1 N·m ist, bleibt das Gelenk stehen; erst darüber beginnt es sich zu drehen.
      }
      
      device [ #Anzusteuernder Motor aus balance_control_c.c
        RotationalMotor {
          name "handlebars motor" #Referenz auf den Motor aus balance_control_c.c
          maxTorque 2 #Maximales Drehmoment des Motors in N·m
        }
      ]
      
      endPoint Solid {
        translation 0 -0.0818 0.102 #Position der Lenkachse
        rotation 0 0 -1 9.884312124119402e-08 #Orientierung der Lenkachse
        
        
        children [
          #Lenkachse ohne weitere Bedeutung
          DEF fork Transform {
            scale 0.001 0.001 0.001 #Skalierung der Lenkachse
            children [
              CadShape {
                url [
                  "obj/Little Bicycle V2 - Handlebars and Fork/fork.obj"
                ]
              }
            ]
          }

          #Vorderrad
          DEF wheel HingeJoint { #Weil hingejoint weiß device das dieses gedreht werden soll

            jointParameters HingeJointParameters {
              position 58.84271107812081
              anchor 0 -0.037 -0.102
              dampingConstant 0.1
              staticFriction 0.1
            }

            endPoint Solid {
              translation 0 -0.037 -0.102
              rotation -1 0 0 3.989141993675058
              children [
                DEF wheel Transform {
                  scale 0.001 0.001 0.001
                  children [
                    CadShape {
                      url [
                        "obj/Little Bicycle - Front Wheel/f_wheel.obj"
                      ]
                    }
                  ]
                }
              ]

              contactMaterial "wheel" #Referenz auf den Kontaktmaterial "wheel" aus der WorldInfo
              
              boundingObject Pose { #Exakt die gleiche Kollisions-Hülle wie bei der Hinterachse
                rotation 0 1 0 1.5708
                children [
                  Cylinder {
                    height 0.015
                    radius 0.055
                    subdivision 72
                  }
                ]
              }

              physics Physics {
                density -1
                mass 0.6
                centerOfMass [
                  0 0 0
                ]
                inertiaMatrix [
                  0.001 0.001 0.001
                  0 0 0
                ]
              }

            }
          }
        ]

        
        name "solid(1)"
        boundingObject Group { #Der aufbau des Lenkrahmens. Der aufwendig!
          children [
            Pose {
              translation 0.0125 -0.024 -0.065
              rotation -1 0 0 0.34909999999999985
              children [
                Shape {
                  geometry Box {
                    size 0.005 0.005 0.093
                  }
                }
              ]
            }
            Pose {
              translation -0.0125 -0.024 -0.065
              rotation 1 0 0 -0.3491
              children [
                Shape {
                  geometry Box {
                    size 0.005 0.005 0.093
                  }
                }
              ]
            }
            Pose {
              translation 0.0125 -0.037 -0.102
              rotation 0 1 0 1.5708
              children [
                Shape {
                  geometry Cylinder {
                    height 0.005
                    radius 0.01
                  }
                }
              ]
            }
            Pose {
              translation -0.0125 -0.037 -0.102
              rotation 0 1 0 1.5708
              children [
                Shape {
                  geometry Cylinder {
                    height 0.005
                    radius 0.01
                  }
                }
              ]
            }
            Pose {
              translation 0 -0.008 -0.022
              rotation 1 0 0 -0.3491
              children [
                Shape {
                  geometry Cylinder {
                    height 0.01
                    radius 0.0125
                  }
                }
              ]
            }
            Pose {
              translation 0 0.0035 0.0085
              rotation 1 0 0 -0.3491
              children [
                Shape {
                  geometry Cylinder {
                    height 0.075
                    radius 0.0025
                  }
                }
              ]
            }
            Pose {
              translation -0.062 0.0121 0.05445
              rotation 0.3796282240312281 0.893242880073478 0.24083099617145198 1.5708
              children [
                Shape {
                  geometry Cylinder {
                    height 0.04
                    radius 0.006
                  }
                }
              ]
            }
            Pose {
              translation 0.062 0.0121 0.05445
              rotation -0.06982912769991387 -0.9687746404465684 0.23790668118464223 1.5708
              children [
                Shape {
                  geometry Cylinder {
                    height 0.04
                    radius 0.006
                  }
                }
              ]
            }
            Pose {
              translation 0 0.0045 0.0441
              rotation 1 0 0 -0.3491
              children [
                Shape {
                  geometry Box {
                    size 0.03 0.005 0.005
                  }
                }
              ]
            }
            Pose {
              translation -0.0203 0.0066 0.0498
              rotation -0.3866558708915664 0.9082106967389628 -0.16015794652158893 0.855791
              children [
                Shape {
                  geometry Box {
                    size 0.0201 0.005 0.005
                  }
                }
              ]
            }
            Pose {
              translation 0.0203 0.0066 0.0498
              rotation 0.3866558708915664 0.9082106967389628 -0.16015794652158893 -0.8557953071795863
              children [
                Shape {
                  geometry Box {
                    size 0.0201 0.005 0.005
                  }
                }
              ]
            }
            Pose {
              translation 0.036 0.0087 0.0556
              rotation 1 0 0 -0.3491
              children [
                Shape {
                  geometry Box {
                    size 0.02 0.005 0.005
                  }
                }
              ]
            }
            Pose {
              translation -0.036 0.0087 0.0556
              rotation 1 0 0 -0.3491
              children [
                Shape {
                  geometry Box {
                    size 0.02 0.005 0.005
                  }
                }
              ]
            }
          ]
        }

        physics Physics {
          density -1
          mass 1.2
          centerOfMass [
            0 0 0
          ]
          inertiaMatrix [
            0.02 0.02 0.005
            0 0 0
          ]
        }
      }

    }





    DEF crank HingeJoint { #Definition der Kurbel
      jointParameters HingeJointParameters {
        position 30.400672892544396
        dampingConstant 0.05
        staticFriction 0.05
      }
      device [
        RotationalMotor {
          name "motor::crank"
          maxVelocity 100
          maxTorque 5
        }
      ]
      endPoint Solid {
        rotation 1 0 0 5.26793166382605
        children [
          DEF crank Transform {
            scale 0.001 0.001 0.001
            children [
              CadShape {
                url [
                  "obj/Little Bicycle - Crank/crank.obj"
                ]
              }
            ]
          }
          DEF pedal HingeJoint {
            jointParameters HingeJointParameters {
              position -30.40025456626206
              anchor -0.0375 -0.03 0
            }
            endPoint Solid {
              translation -0.0375 -0.03 0
              rotation -1 0 0 5.267513337543714
              children [
                DEF pedal Transform {
                  scale 0.001 0.001 0.001
                  children [
                    CadShape {
                      url [
                        "obj/Little Bicycle - Pedal/pedal.obj"
                      ]
                    }
                  ]
                }
              ]
              boundingObject Pose {
                children [
                  Shape {
                    geometry Box {
                      size 0.02 0.02 0.006
                    }
                  }
                ]
              }
              physics Physics {
                density -1
                mass 0.05
                centerOfMass [
                  0 0 0
                ]
              }
            }
          }
          DEF pedal HingeJoint {
            jointParameters HingeJointParameters {
              position -30.40025456626206
              anchor 0.0375 0.03 0
            }
            endPoint Solid {
              translation 0.0375 0.03 0
              rotation -1 0 0 5.267513337543714
              children [
                DEF pedal Transform {
                  scale 0.001 0.001 0.001
                  children [
