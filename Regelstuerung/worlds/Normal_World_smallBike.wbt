                    geometry Box {
                      size 0.02 0.02 0.006
                    }
                  }
                ]
              }
              physics Physics {
                density -1
                mass 0.05
                centerOfMass [
                  0 0 0
                ]
              }
            }
          }
        ]
        name "solid(2)"
        boundingObject Group {
          children [
            Pose {
              translation -0.0238 -0.015 0
              children [
                Shape {
                  geometry Box {
                    size 0.005 0.04 0.01
                  }
                }
